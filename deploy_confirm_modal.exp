#!/usr/bin/expect -f
set timeout 600
set password "-4V2HOvVFF,q7Bx2"
set server "root@187.77.140.205"
set remote_dir "/root/super_real_estate"
set local_dir "/Users/zinwaishine/Desktop/super_real_estate"

set files {
    "frontend/src/components/ui/ConfirmModal.js"
}

# 1. Copy file to server
foreach f $files {
    puts "Copying $f to Hostinger..."
    spawn scp -o StrictHostKeyChecking=no "$local_dir/$f" "$server:$remote_dir/$f"
    expect {
        "password:" {
            send -- "$password\r"
            exp_continue
        }
        eof
    }
}

puts "\nFiles synced! Rebuilding frontend on Hostinger...\n"

# 2. Restart frontend
spawn ssh -o StrictHostKeyChecking=no "$server" "cd $remote_dir && docker compose restart frontend"
expect {
    "password:" {
        send -- "$password\r"
        exp_continue
    }
    timeout {
        puts "Restart timed out."
    }
    eof
}

puts "\nHostinger update complete!"
