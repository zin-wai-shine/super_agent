# Copy to .env and adjust. Used when running backend locally (go run main.go).
# If you use Docker for DB only: docker compose up -d db
# Then set DB_HOST=localhost and DB_PORT=5433 (host port in docker-compose).

DB_HOST=localhost
DB_PORT=5432
DB_USER=super_admin
DB_PASSWORD=super_secret_password
DB_NAME=super_real_estate
JWT_SECRET=your_jwt_secret_change_in_production
UPLOAD_PATH=./uploads

# Optional: AI features (Millionaire Plan)
# AI_API_URL=https://api.openai.com
# AI_API_KEY=sk-...
