#!/usr/bin/expect -f
set timeout 600
set password "-4V2HOvVFF,q7Bx2"
set server "root@187.77.140.205"
set remote_dir "/root/super_real_estate"
set local_dir "/Users/zinwaishine/Desktop/super_real_estate"

# List of files modified today to sync
set files {
    "frontend/src/components/ui/ListingSkeleton.js"
    "frontend/src/pages/Public/ListingDetailPage.js"
    "frontend/src/components/Listings/AllPhotosModalContent.js"
    "frontend/src/components/Listings/ListingDetailModal.js"
    "frontend/src/pages/Public/BannerDetail.js"
    "frontend/src/pages/Public/CollectionDetailPage.js"
    "frontend/src/pages/Public/CollectionsPage.js"
    "frontend/src/pages/Public/MyBookings.js"
    "frontend/src/pages/Public/SavedListingsPage.js"
}

# 1. Copy files to server
foreach f $files {
    puts "Copying $f to Hostinger..."
    spawn scp -o StrictHostKeyChecking=no "$local_dir/$f" "$server:$remote_dir/$f"
    expect {
        "password:" {
            send -- "$password\r"
            exp_continue
        }
        eof
    }
}

puts "\nFiles synced! Rebuilding frontend on Hostinger...\n"

# 2. Rebuild only frontend (safe, no DB touch)
spawn ssh -o StrictHostKeyChecking=no "$server" "cd $remote_dir && docker compose build frontend && docker compose up -d frontend"
expect {
    "password:" {
        send -- "$password\r"
        exp_continue
    }
    timeout {
        puts "Build timed out."
    }
    eof
}

puts "\nHostinger update complete!"
